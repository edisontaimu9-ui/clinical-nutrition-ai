# --- Secrets and environment ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials*.json

# --- Data safety: never commit patient-like or bulk data ---
# Synthetic cases are allowed only as reviewed JSON under data/synthetic and db/seeds.
*.csv
*.xlsx
*.xls
*.sqlite
*.sqlite3
*.db
*.dump
*.sql.gz
*.bak
backups/
exports/
!data/synthetic/**/*.csv

# --- Model weights and large artifacts ---
*.gguf
*.safetensors
*.bin
*.onnx
*.pt
*.pth
models/
weights/

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
/build/*
!/build/profiles/
*.egg-info/

# --- Node ---
node_modules/
.next/
.vite/

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# --- Logs ---
*.log
logs/
